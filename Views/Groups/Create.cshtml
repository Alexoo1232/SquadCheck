@model SquadCheck.Models.ViewModels.CreateGroupViewModel

@{
    ViewData["Title"] = "Create group";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="Groups" asp-action="Index" class="text-decoration-none">
            ← Back to groups
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h3 mb-2">Create group</h1>
                    <p class="text-muted">
                        Add a new sports group or team.
                    </p>

                    <form asp-controller="Groups" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Example: Basketball Team" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Short description of the group"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-sm-flex">
                            <button type="submit" class="btn btn-primary">
                                Create group
                            </button>

                            <a asp-controller="Groups" asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
