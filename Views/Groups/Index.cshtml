@model List<SquadCheck.Models.ViewModels.GroupListItemViewModel>

@{
    ViewData["Title"] = "Groups";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 page-header">
        <div>
            <h1 class="page-title">Groups</h1>
            <p class="page-subtitle">Create and manage your practice groups.</p>
        </div>

        <div>
            <a asp-controller="Groups"
               asp-action="Create"
               class="btn btn-primary mobile-action">
                Create group
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card app-card">
            <div class="card-body empty-state">
                <h2>No groups yet</h2>
                <p class="text-muted">
                    Create your first group to start planning practices.
                </p>

                <a asp-controller="Groups"
                   asp-action="Create"
                   class="btn btn-primary mobile-action">
                    Create group
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card app-card action-card h-100">
                        <div class="card-body">
                            <h2 class="h5 mb-2">@item.Group.Name</h2>

                            @if (!string.IsNullOrWhiteSpace(item.Group.Description))
                            {
                                <p class="text-muted mb-3">@item.Group.Description</p>
                            }
                            else
                            {
                                <p class="text-muted mb-3">No description added.</p>
                            }

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="summary-box">
                                        <p class="summary-number">@item.MemberCount</p>
                                        <div class="summary-label">Members</div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="summary-box">
                                        <p class="summary-number">@item.UpcomingPracticeCount</p>
                                        <div class="summary-label">Upcoming</div>
                                    </div>
                                </div>
                            </div>

                            <a asp-controller="Groups"
                               asp-action="Details"
                               asp-route-id="@item.Group.Id"
                               class="btn btn-outline-primary mobile-action">
                                Open
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
