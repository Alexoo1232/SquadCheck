@model List<SquadCheck.Models.Group>

@{
    ViewData["Title"] = "Groups";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Groups</h1>
            <p class="text-muted mb-0">Manage your sports groups and teams.</p>
        </div>

        <a asp-controller="Groups" asp-action="Create" class="btn btn-primary">
            Create group
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h2 class="h5">No groups yet</h2>
                <p class="text-muted">
                    Create your first group to start planning practices and attendance.
                </p>

                <a asp-controller="Groups" asp-action="Create" class="btn btn-primary">
                    Create group
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var group in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5 mb-2">@group.Name</h2>

                            @if (!string.IsNullOrWhiteSpace(group.Description))
                            {
                                <p class="text-muted">@group.Description</p>
                            }
                            else
                            {
                                <p class="text-muted">No description added.</p>
                            }

                            <p class="mb-1">
                                <strong>Members:</strong> @group.Members.Count
                            </p>

                            <p class="mb-3">
                                <strong>Practices:</strong> @group.PracticeSessions.Count
                            </p>

                            <a asp-controller="Groups"
                               asp-action="Details"
                               asp-route-id="@group.Id"
                               class="btn btn-outline-primary w-100">
                                Open group
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
