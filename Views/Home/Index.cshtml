@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <div class="page-header">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">
            Plan practices, manage groups, and collect attendance
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card app-card action-card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-2">Groups</h2>
                    <p class="text-muted">
                        Create teams, add members, and manage group information.
                    </p>

                    <div class="mobile-stack d-sm-flex gap-2">
                        <a asp-controller="Groups"
                           asp-action="Index"
                           class="btn btn-primary mobile-action">
                            Open groups
                        </a>

                        <a asp-controller="Groups"
                           asp-action="Create"
                           class="btn btn-outline-primary mobile-action">
                            Create group
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card app-card action-card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-2">Practices</h2>
                    <p class="text-muted">
                        Create practice sessions and check attendance answers.
                    </p>

                    <div class="mobile-stack d-sm-flex gap-2">
                        <a asp-controller="Practices"
                           asp-action="Index"
                           class="btn btn-primary mobile-action">
                            Open practices
                        </a>

                        <a asp-controller="Practices"
                           asp-action="Create"
                           class="btn btn-outline-primary mobile-action">
                            Create practice
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card app-card">
        <div class="card-body">
            <h2 class="h5 mb-2">Example workflow</h2>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="summary-box">
                        <p class="summary-number">1</p>
                        <div class="summary-label">Create a group</div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="summary-box">
                        <p class="summary-number">2</p>
                        <div class="summary-label">Add members</div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="summary-box">
                        <p class="summary-number">3</p>
                        <div class="summary-label">Mark attendance</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
