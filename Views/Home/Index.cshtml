@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container mt-4">
    <h2>SquadCheck Test</h2>

    <div class="alert alert-info">
        @ViewBag.TestResult
    </div>

    <div class="card p-3">
        <p><strong>Users:</strong> @ViewBag.UserCount</p>
        <p><strong>Groups:</strong> @ViewBag.GroupCount</p>
        <p><strong>Practice sessions:</strong> @ViewBag.SessionCount</p>

        <hr />

        <h5>Attendance summary</h5>
        <p><strong>Going:</strong> @ViewBag.GoingCount</p>
        <p><strong>Not going:</strong> @ViewBag.NotGoingCount</p>
        <p><strong>Maybe:</strong> @ViewBag.MaybeCount</p>
        <p><strong>No response:</strong> @ViewBag.NoResponseCount</p>
    </div>
</div>
