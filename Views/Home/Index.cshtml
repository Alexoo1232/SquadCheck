@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Quick overview of your groups and upcoming practices.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total groups</div>
                    <div class="display-6">@ViewBag.GroupCount</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Upcoming practices</div>
                    <div class="display-6">@ViewBag.UpcomingPracticeCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Quick links</h2>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <a asp-controller="Groups" asp-action="Index" class="btn btn-primary">
                    Groups
                </a>

                <a asp-controller="Practices" asp-action="Index" class="btn btn-outline-primary">
                    Practices
                </a>
            </div>
        </div>
    </div>
</div>
