@model List<SquadCheck.Models.PracticeSession>

@{
    ViewData["Title"] = "Practices";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Practices</h1>
            <p class="text-muted mb-0">View and manage practice sessions.</p>
        </div>

        <a asp-controller="Practices" asp-action="Create" class="btn btn-primary">
            Create practice
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @{
        var upcomingSessions = Model
            .Where(session => session.IsUpcoming())
            .OrderBy(session => session.StartTime)
            .ToList();

        var pastSessions = Model
            .Where(session => !session.IsUpcoming())
            .OrderByDescending(session => session.StartTime)
            .ToList();
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Upcoming practices</h2>

            @if (upcomingSessions.Count == 0)
            {
                <p class="text-muted mb-0">No upcoming practices have been created yet.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var session in upcomingSessions)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border">
                                <div class="card-body">
                                    <h3 class="h5 mb-2">@session.Title</h3>

                                    <p class="text-muted mb-1">
                                        @session.StartTime.ToString("yyyy-MM-dd HH:mm")
                                        -
                                        @session.EndTime.ToString("HH:mm")
                                    </p>

                                    <p class="mb-2">@session.Location</p>

                                    @if (session.MaxParticipants.HasValue)
                                    {
                                        <p class="text-muted mb-3">
                                            Max participants: @session.MaxParticipants
                                        </p>
                                    }

                                    <a asp-controller="Practices"
                                       asp-action="Details"
                                       asp-route-id="@session.Id"
                                       class="btn btn-outline-primary w-100">
                                        Open practice
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Past practices</h2>

            @if (pastSessions.Count == 0)
            {
                <p class="text-muted mb-0">No past practices yet.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var session in pastSessions)
                    {
                        <a asp-controller="Practices"
                           asp-action="Details"
                           asp-route-id="@session.Id"
                           class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <h3 class="h6 mb-1">@session.Title</h3>
                                    <p class="text-muted mb-0">
                                        @session.StartTime.ToString("yyyy-MM-dd HH:mm")
                                        -
                                        @session.EndTime.ToString("HH:mm")
                                    </p>
                                </div>

                                <span class="badge bg-secondary">Past</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
