@model List<SquadCheck.Models.PracticeSession>

@{
    ViewData["Title"] = "Practices";

    var upcomingSessions = Model
        .Where(session => session.IsUpcoming())
        .OrderBy(session => session.StartTime)
        .ToList();

    var pastSessions = Model
        .Where(session => !session.IsUpcoming())
        .OrderByDescending(session => session.StartTime)
        .ToList();
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 page-header">
        <div>
            <h1 class="page-title">Practices</h1>
            <p class="page-subtitle">Create practice sessions and view attendance.</p>
        </div>

        <div>
            <a asp-controller="Practices"
               asp-action="Create"
               class="btn btn-primary mobile-action">
                Create practice
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4">
        <h2 class="h5 mb-3">Upcoming practices</h2>

        @if (upcomingSessions.Count == 0)
        {
            <div class="card app-card">
                <div class="card-body empty-state">
                    <h2>No upcoming practices</h2>
                    <p class="text-muted">
                        Create a practice session to start collecting attendance.
                    </p>

                    <a asp-controller="Practices"
                       asp-action="Create"
                       class="btn btn-primary mobile-action">
                        Create practice
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var session in upcomingSessions)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card app-card action-card h-100">
                            <div class="card-body">
                                <h3 class="h5 mb-2">@session.Title</h3>

                                <div class="mb-3">
                                    <p class="info-label">Date and time</p>
                                    <p class="info-value">
                                        @session.StartTime.ToString("yyyy-MM-dd HH:mm")
                                        -
                                        @session.EndTime.ToString("HH:mm")
                                    </p>
                                </div>

                                <div class="mb-3">
                                    <p class="info-label">Location</p>
                                    <p class="info-value">@session.Location</p>
                                </div>

                                @if (session.MaxParticipants.HasValue)
                                {
                                    <div class="mb-3">
                                        <p class="info-label">Max participants</p>
                                        <p class="info-value">@session.MaxParticipants</p>
                                    </div>
                                }

                                <a asp-controller="Practices"
                                   asp-action="Details"
                                   asp-route-id="@session.Id"
                                   class="btn btn-outline-primary mobile-action">
                                    Open
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div>
        <h2 class="h5 mb-3">Past practices</h2>

        @if (pastSessions.Count == 0)
        {
            <p class="text-muted">No past practices yet.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var session in pastSessions)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card app-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h6 mb-0">@session.Title</h3>
                                    <span class="badge bg-secondary">Past</span>
                                </div>

                                <p class="text-muted mb-3">
                                    @session.StartTime.ToString("yyyy-MM-dd HH:mm")
                                </p>

                                <a asp-controller="Practices"
                                   asp-action="Details"
                                   asp-route-id="@session.Id"
                                   class="btn btn-outline-secondary mobile-action">
                                    Open
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
